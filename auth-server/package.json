{
  "name": "auth-server",
  "version": "1.0.0",
  "private": true,
  "description": "Auth server (JWT + introspection)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/index.cjs",
    "start": "node dist/index.cjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@oauth-flow-demo/shared": "*",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "jose": "^6.2.18"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6"
  }
}
