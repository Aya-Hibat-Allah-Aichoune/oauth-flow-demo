{
  "name": "oauth-flow-demo",
  "version": "1.0.0",
  "private": true,
  "description": "OAuth password + JWT + introspection demo",
  "type": "module",
  "workspaces": [
    "shared",
    "auth-server",
    "service",
    "client"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names auth,service,client --prefix-colors blue,magenta,green \"npm run dev -w auth-server\" \"npm run dev -w service\" \"npm run dev -w client\"",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && npm run test:e2e",
    "test:e2e": "vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.19.2",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.2.5",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.7"
  }
}
